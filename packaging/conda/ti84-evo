#!/usr/bin/env sh
set -eu

prefix=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
jar="$prefix/share/ti84-evo/ti84-evo-cli.jar"

if [ ! -f "$jar" ]; then
    echo "Missing $jar. Reinstall the ti84-evo-cli Conda package." >&2
    exit 1
fi

exec java --enable-native-access=ALL-UNNAMED -jar "$jar" "$@"
